# ============================================================================
# GTA 6 (PS5) Canlı Türkçe Altyazı Sistemi — Ortam Değişkenleri Şablonu
# ============================================================================

# Çeviri Motoru Seçimi:
# - "ollama" : Varsayılan! M2 MacBook Pro üzerinde yerel Ollama + SQLite Önbellek
# - "auto"   : SQLite önbellek -> Yerel Ollama -> Gemini -> DeepL
# - "gemini" : Google Gemini Flash API + SQLite Önbellek
# - "deepl"  : DeepL API Free + SQLite Önbellek
TRANSLATION_PROVIDER=ollama

# Yerel LLM (M2 MacBook Pro üzerinde Ollama — http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Opsiyonel Bulut Anahtarları
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPL_API_KEY=
